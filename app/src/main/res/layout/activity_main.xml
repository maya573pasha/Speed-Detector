<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F">

    <!-- Camera preview fills screen -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Overlay for boxes -->
    <com.cv.speeddetector.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ══════════════════ TOP HUD ══════════════════ -->
    <LinearLayout
        android:id="@+id/topHud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Speed card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="#CC000000"
            app:cardCornerRadius="20dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="52sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSpeedUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-6dp"
                    android:text="km/h"
                    android:textAllCaps="true"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Max / Avg card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="#CC000000"
            app:cardCornerRadius="20dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="10dp"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/tvMaxSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAX --"
                    android:textColor="#FFD700"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAvgSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="AVG --"
                    android:textColor="#888888"
                    android:textSize="13sp" />

                <!-- Mini speed graph -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:baselineAligned="false">

                    <View android:id="@+id/bar0" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="#1A4060"/>
                    <View android:id="@+id/bar1" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="#1A4060"/>
                    <View android:id="@+id/bar2" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="#1A4060"/>
                    <View android:id="@+id/bar3" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="#1A4060"/>
                    <View android:id="@+id/bar4" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="#1A4060"/>
                    <View android:id="@+id/bar5" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="#1A4060"/>
                    <View android:id="@+id/bar6" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="#1A4060"/>
                    <View android:id="@+id/bar7" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="#00E5FF"/>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ══════════════════ STATS BAR ══════════════════ -->
    <LinearLayout
        android:id="@+id/statsBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topHud">

        <!-- Objects detected -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardBackgroundColor="#BB000000"
            app:cardCornerRadius="14dp"
            app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:paddingVertical="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="OBJECTS" android:textColor="#555555" android:textSize="9sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvObjectCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Scale -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardBackgroundColor="#BB000000"
            app:cardCornerRadius="14dp"
            app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:paddingVertical="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SCALE" android:textColor="#555555" android:textSize="9sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvScaleVal" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="--"
                    android:textColor="#FFD700" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Session timer -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="#BB000000"
            app:cardCornerRadius="14dp"
            app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:paddingVertical="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SESSION" android:textColor="#555555" android:textSize="9sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvSessionTime" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="00:00"
                    android:textColor="#4CAF50" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ══════════════════ HISTORY (left side) ══════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="180dp"
        app:cardBackgroundColor="#99000000"
        app:cardCornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:text="HISTORY"
                android:textColor="#555555" android:textSize="9sp" android:textStyle="bold"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/tvHistory" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="No records yet"
                android:textColor="#CCCCCC" android:textSize="11sp" android:lineSpacingExtra="3dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════ TARGET CARD ══════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTarget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#CC00E5FF"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/cardControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="0dp"
        tools:visibility="visible">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">

            <TextView android:id="@+id/tvTargetInfo" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Locked: ID #3"
                android:textColor="#000000" android:textStyle="bold" android:textSize="13sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:text="SAVE"
                android:textColor="#000000" app:rippleColor="#40000000"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════ BOTTOM CONTROLS ══════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#E6000000"
        app:cardCornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Row 1: Lock + Start/Stop -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLock"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp" android:layout_height="48dp"
                    android:layout_weight="1" android:layout_marginEnd="8dp"
                    android:text="TAP TO LOCK" android:textSize="11sp"
                    app:cornerRadius="14dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartStop"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp" android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="START" android:textSize="13sp"
                    app:cornerRadius="14dp"/>
            </LinearLayout>

            <!-- Row 2: Calibrate + Unit -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalibrate"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="2" android:layout_marginEnd="8dp"
                    android:text="CALIBRATE" android:textSize="11sp"
                    app:cornerRadius="14dp" app:strokeColor="#333333"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnit"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="KM/H" android:textSize="11sp"
                    app:cornerRadius="14dp" app:strokeColor="#333333"/>
            </LinearLayout>

            <!-- Status -->
            <TextView
                android:id="@+id/tvCalibStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Status: Not calibrated"
                android:textColor="#FFCC00"
                android:textSize="12sp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════ SPLASH SCREEN ══════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/startOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2000000"
        android:clickable="true"
        android:focusable="true">

        <ImageView android:id="@+id/imgLogo"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/ic_launcher_foreground"
            app:layout_constraintBottom_toTopOf="@+id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>

        <TextView android:id="@+id/tvTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SPEED DETECTOR"
            android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/tvSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLogo"/>

        <TextView android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tap an object · Lock on · Track speed"
            android:textColor="#888888" android:textSize="13sp"
            app:layout_constraintBottom_toTopOf="@+id/btnGetStarted"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetStarted"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content" android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:paddingHorizontal="40dp"
            android:text="GET STARTED" android:textSize="16sp"
            app:cornerRadius="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>